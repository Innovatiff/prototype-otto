rules_version = '2';

// Otto Firestore rules.
//
// Contract:
//   - A user can read and write only documents whose ownerId is their uid.
//   - cost_events and cost_daily are server-only: no client access at all.
//     (The Admin SDK on Cloud Run bypasses rules; nothing else gets in.)
//   - Everything else is denied by default.
//
// Rules enforce OWNERSHIP; document shape is enforced by the API layer, which
// validates every write against the Zod schemas in shared/schemas/. Phase 0
// clients talk only to the API, but these rules hold even if a client ever
// touches Firestore directly.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // The existing document belongs to the caller.
    function ownsExisting() {
      return signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // The incoming document (create/update payload) belongs to the caller —
    // blocks both spoofed creates and ownership transfers.
    function ownsIncoming() {
      return signedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    // The owner's profile. Document id IS the uid, so identity is the path.
    match /users/{userId} {
      allow read, delete: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.ownerId == userId;
    }

    match /tasks/{taskId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
    }

    match /memories/{memoryId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
    }

    // Plans land in Phase 4; locking the collection down now costs nothing.
    match /plans/{planId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
    }

    // Conversation sessions are written and read only by the API server —
    // clients carry just the sessionId string.
    match /sessions/{sessionId} {
      allow read, write: if false;
    }

    // Morning briefs are stored server-side for day-to-day continuity;
    // clients receive them over the API only.
    match /briefs/{briefId} {
      allow read, write: if false;
    }

    // Server-only telemetry — no client access, not even to your own rollup.
    match /cost_events/{eventId} {
      allow read, write: if false;
    }

    match /cost_daily/{rollupId} {
      allow read, write: if false;
    }

    // Deny by default. (Unmatched paths are denied anyway; this states it.)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
